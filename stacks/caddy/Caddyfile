# ---- Public (7 vhosts, 5 names) ----

auth.example.com, https://auth.example.com:8443 {
	import edge_log
	import scanner_deny
	crowdsec
	appsec
	reverse_proxy https://authentik-server-1:9443 {
		# Authentik reads the RIGHTMOST X-Forwarded-For entry outside its own trusted
		# CIDRs, which on the Cloudflare path is the edge server, not the visitor. Its
		# failed-login events then name a Cloudflare PoP, and a CrowdSec ban lands on that
		# PoP — every visitor behind it. Handing it the address Caddy already recovered
		# from CF-Connecting-IP is what makes firix/authentik-bf usable at all.
		# On :443 nothing is a trusted proxy, so {client_ip} is simply the peer.
		header_up X-Forwarded-For {client_ip}
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Straight to the app, not through the Authentik outpost: Quantum runs the OIDC flow
# itself, so share and upload links resolve without skip_path_regex holes.
#
# The ONLY public vhost without `import scanner_deny`: Quantum serves user-controlled
# paths, so a file someone uploads or shares could legitimately be named `.env.bak` or
# sit under a `.git/` directory, and the blanket deny would 403 their own file. No
# match has ever been logged on this host, scanner or otherwise — revisit if one is.
files.example.com, https://files.example.com:8443 {
	import edge_log
	crowdsec
	appsec
	reverse_proxy http://files:30052
}

# Split like jellyfin below, for the same reason: LAN/tailnet :443 keeps Immich's
# native password login, the public :8443 twin does not.
immich.example.com {
	import edge_log
	import scanner_deny
	crowdsec
	appsec
	reverse_proxy http://immich-server-1:30041
}

# Password login and admin sign-up are blocked at the public edge only. /api/oauth/*
# (web and the mobile app) and anonymous /share/ links are not matched, so they stay open.
https://immich.example.com:8443 {
	import edge_log
	import scanner_deny
	crowdsec
	appsec
	@pw_login path_regexp (?i)^/api/auth/(login|admin-sign-up)$
	respond @pw_login 403
	reverse_proxy http://immich-server-1:30041
}

mealie.example.com, https://mealie.example.com:8443 {
	import edge_log
	import scanner_deny
	crowdsec
	appsec
	reverse_proxy http://mealie:9000
}

# Jellyfin's public edge is a separate site block, not a conditional inside one, so
# "am I on the public edge?" never has to be asked. LAN keeps native password login.
jellyfin.example.com {
	import edge_log
	import hls_playlists
	import scanner_deny
	crowdsec
	appsec
	reverse_proxy http://jellyfin:8096
}

# Password endpoints are blocked at the public edge only; /sso/* and /QuickConnect/*
# stay open by not being matched. See docs/runbooks/setup-operations/jellyfin-authentik-sso.md.
https://jellyfin.example.com:8443 {
	import edge_log
	import hls_playlists
	import scanner_deny
	crowdsec
	appsec
	@pw_login path_regexp (?i)^/(emby/)?users/(authenticatebyname|public)$
	@pw_login_byid path_regexp (?i)^/(emby/)?users/[^/]+/authenticate$
	respond @pw_login 403
	respond @pw_login_byid 403
	reverse_proxy http://jellyfin:8096
}
