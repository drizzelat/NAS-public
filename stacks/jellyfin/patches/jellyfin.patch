+        {
+            ceiling = Math.Min(ceiling, (int)(EncodingHelper.ScaleBitrate(sourceVideoBitrate.Value, state.VideoStream!.Codec, state.ActualOutputVideoCodec) * 0.9));
+        }
+
+        return ceiling;
+    }
